{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineops/schema/incident-finding.schema.json",
  "title": "IncidentFinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "level"],
  "properties": {
    "finding_id": { "type": "string", "minLength": 1 },
    "shot_id": { "type": ["string", "null"] },
    "level": { "type": "string", "enum": ["ok", "low", "medium", "high", "blocked"] },
    "rule_ids": { "type": "array", "items": { "type": "string" } },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "commitment_ids": { "type": "array", "items": { "type": "string" } },
    "at_risk_hours": { "type": "number" }
  }
}
