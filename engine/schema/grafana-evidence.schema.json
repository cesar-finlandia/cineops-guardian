{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineops/schema/grafana-evidence.schema.json",
  "title": "GrafanaEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "kind", "mcp_tool", "row_count"],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["metrics", "logs", "traces", "dashboards", "alerts", "incidents"] },
    "mcp_tool": { "type": "string", "minLength": 1 },
    "args": { "type": "object" },
    "rows": { "type": "array", "items": { "type": "object" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "grafana_link": { "type": ["string", "null"] },
    "took_ms": { "type": "integer", "minimum": 0 },
    "degraded": { "type": "boolean" },
    "synthetic": { "type": "boolean" }
  }
}
