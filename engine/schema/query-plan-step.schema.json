{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineops/schema/query-plan-step.schema.json",
  "title": "QueryPlanStep",
  "type": "object",
  "additionalProperties": false,
  "required": ["step_no", "kind", "tool_hint", "why"],
  "properties": {
    "step_no": { "type": "integer", "minimum": 1 },
    "kind": { "type": "string", "enum": ["metrics", "logs", "traces", "dashboards", "alerts", "incidents"] },
    "tool_hint": { "type": "string", "minLength": 1 },
    "args": { "type": "object" },
    "why": { "type": "string", "minLength": 1 }
  }
}
