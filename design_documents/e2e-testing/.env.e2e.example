# Local-only E2E secrets (NEVER commit — copy to `.env.e2e` next to this file).
# The T1 backend and the Grafana MCP stdio child inherit these via the
# Playwright webServer env map. CI / fresh machines: leave Grafana empty to
# exercise the honest-degraded path; Vertex needs ADC (`gcloud auth
# application-default login`) rather than any key below.
E2E_GOOGLE_CLOUD_PROJECT=
E2E_GOOGLE_CLOUD_LOCATION=us-central1
E2E_GEMINI_MODEL=gemini-2.5-flash
E2E_GRAFANA_STACK_URL=http://127.0.0.1:3000
E2E_GRAFANA_SERVICE_ACCOUNT_TOKEN=
E2E_GRAFANA_TRANSPORT=stdio
E2E_BQ_DATASET=cineops
# Optional: explicit path to the grafana/mcp-grafana binary. Leave empty to let
# the config find it in `.e2e-bin/` or on PATH (E2E F19).
E2E_MCP_GRAFANA_BIN=
