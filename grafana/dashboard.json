{
  "uid": "cineops-render-queue",
  "title": "CineOps — PALS render queue",
  "tags": [
    "cineops",
    "synthetic"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Render queue latency (max, sec) — PALS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (vendor) (cineops_render_queue_latency_seconds{production=\"PALS\"})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Failed jobs — PALS",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{production=\"PALS\"} |= \"failed\""
        }
      ]
    }
  ]
}
