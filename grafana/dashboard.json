{
  "uid": "cineops-render-queue",
  "title": "CineOps — NEON HOLLOW render queue",
  "tags": [
    "cineops",
    "synthetic"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Render queue latency (p95, sec) — NEON HOLLOW",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, vendor) (rate(cineops_render_queue_latency_seconds_bucket{production=\"NEON HOLLOW\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Failed jobs — NEON HOLLOW",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{production=\"NEON HOLLOW\"} |= \"failed\""
        }
      ]
    }
  ]
}
